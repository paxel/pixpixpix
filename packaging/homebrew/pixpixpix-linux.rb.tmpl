class Pixpixpix < Formula
  desc "Fast keyboard-first image and video viewer"
  homepage "https://github.com/paxel/pixpixpix"
  version "{{VERSION}}"
  license "MIT"

  depends_on :linux

  on_arm do
    url "https://github.com/paxel/pixpixpix/releases/download/v#{version}/pixpixpix-#{version}-linux-aarch64.tar.gz"
    sha256 "{{SHA_LINUX_AARCH64}}"
  end
  on_intel do
    url "https://github.com/paxel/pixpixpix/releases/download/v#{version}/pixpixpix-#{version}-linux-x86_64.tar.gz"
    sha256 "{{SHA_LINUX_X86_64}}"
  end

  def install
    libexec.install Dir["*"]
    # Symlinks, not exec scripts: the app follows bin/pixpixpix back to itself and
    # points its own launcher entry at that stable path, which survives upgrades.
    bin.install_symlink libexec/"pixpixpix"
    bin.install_symlink libexec/"pix3"

    # An absolute Exec: a desktop session does not read Homebrew's shell environment,
    # so its bin directory is not on the session's PATH. The icon stays a theme name,
    # "pixpixpix": the install step below puts the PNG into ~/.local/share/icons,
    # where every desktop looks, and the app keeps it there.
    inreplace libexec/"io.github.paxel.pixpixpix.desktop" do |entry|
      entry.gsub! "Exec=pixpixpix", "Exec=#{opt_bin}/pixpixpix"
    end

    # The helper and everything it copies live together, so it finds the icons next
    # to itself. A wrapper rather than a symlink, for the same reason.
    (libexec/"install-icon.sh").chmod 0755
    (bin/"pixpixpix-install-icon").write <<~SH
      #!/bin/sh
      exec "#{opt_libexec}/install-icon.sh" "$@"
    SH
    (bin/"pixpixpix-install-icon").chmod 0755

    # Also in Homebrew's own share, for the sessions that do read it.
    (share/"applications").mkpath
    cp libexec/"io.github.paxel.pixpixpix.desktop", share/"applications/io.github.paxel.pixpixpix.desktop"
    (share/"icons/hicolor/256x256/apps").mkpath
    cp libexec/"icon_256.png", share/"icons/hicolor/256x256/apps/pixpixpix.png"
  end

  # Homebrew's own share directory is not on a desktop session's XDG_DATA_DIRS, so
  # the entry above alone stays invisible to menus and to "Open with". This step puts
  # the launcher entry and the icons into ~/.local/share, which every session reads.
  # Declared steps replace the post_install method since Homebrew 7.0. A home that
  # cannot be written must not fail the install over a menu entry: pixpixpix writes
  # the same entry itself after its first frame.
  post_install_steps do
    run "install-icon.sh", base: :libexec, must_succeed: false
  end

  def caveats
    <<~EOS
      pixpixpix loads some libraries from your distribution on first need:
      libturbojpeg for lossless JPEG turns, libheif for HEIC/HEIF and AVIF,
      libmpv for videos (e.g. Debian/Ubuntu:
      sudo apt install libturbojpeg libheif1 libheif-plugin-libde265 libheif-plugin-dav1d libmpv2).

      The install puts pixpixpix into your application menu and into "Open with"
      for images and videos, under ~/.local/share; it never becomes the default app.
      If it is missing there, for another user on this machine, or with a custom
      XDG_DATA_HOME, run:

        pixpixpix-install-icon

      Before brew uninstall, to take the menu entry out again:

        pixpixpix-install-icon --uninstall
    EOS
  end

  test do
    assert_predicate libexec/"pixpixpix", :executable?
    assert_predicate bin/"pix3", :exist?
  end
end
